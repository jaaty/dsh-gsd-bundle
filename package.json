{
  "name": "@dsh-gsd/bundle",
  "version": "2.2.0",
  "description": "A DeepSeek Harness plugin bundle that reimplements opengsd-core (Git Ship Done) as a host-plane plugin set, replacing the default agent-loop behavior with the GSD phase loop (Discuss -> UI design -> Plan -> Execute -> Verify -> Ship). Includes checkpoint-resume, a window ledger, a conversational UAT loop, capability gates, and a real background-job runtime.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "opengsd",
    "git",
    "ship",
    "automation",
    "agile"
  ],
  "author": "jaaty <jamie.atyeo@live.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaaty/dsh-gsd-bundle.git"
  },
  "homepage": "https://github.com/jaaty/dsh-gsd-bundle",
  "bugs": {
    "url": "https://github.com/jaaty/dsh-gsd-bundle/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./lib/persona.js",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "node --test test/*.test.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/persona.js"
    },
    "./persona": {
      "default": "./lib/persona.js"
    },
    "./state": {
      "default": "./lib/state.js"
    },
    "./core-tools": {
      "default": "./lib/core-tools.js"
    },
    "./discuss": {
      "default": "./lib/discuss.js"
    },
    "./plan": {
      "default": "./lib/plan.js"
    },
    "./execute": {
      "default": "./lib/execute.js"
    },
    "./code-review": {
      "default": "./lib/code-review.js"
    },
    "./verify": {
      "default": "./lib/verify.js"
    },
    "./ship": {
      "default": "./lib/ship.js"
    },
    "./spec": {
      "default": "./lib/spec.js"
    },
    "./gap-analysis": {
      "default": "./lib/gap-analysis.js"
    },
    "./ui": {
      "default": "./lib/ui.js"
    },
    "./ui-review": {
      "default": "./lib/ui-review.js"
    },
    "./validate": {
      "default": "./lib/validate-phase.js"
    },
    "./quick": {
      "default": "./lib/quick.js"
    },
    "./map-codebase": {
      "default": "./lib/map-codebase.js"
    },
    "./commands": {
      "default": "./lib/commands.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "cordis.patch.yml",
    "README.md",
    "NOTICE",
    "DISTRIBUTION.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}